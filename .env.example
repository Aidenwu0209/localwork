# ---- inference (all app code speaks logical model names via the gateway) ----
# Logical names: brain / perceive / sentinel / fast / embed  (optional: rerank)
GATEWAY_URL=http://127.0.0.1:4000/v1
# agentd compute router: Radeon first, then a real Local Metal request on
# classified availability/product failures. GATEWAY_URL remains the backward-
# compatible Radeon default when RADEON_GATEWAY_URL is unset.
RADEON_GATEWAY_URL=http://127.0.0.1:14000/v1
LOCAL_GATEWAY_URL=http://127.0.0.1:4000/v1
# Local privacy gate for unfiltered frame pixels. memoryd calls this Sentinel
# before OCR, storage, or any allowed request through GATEWAY_URL; keep it on
# the data-sovereignty machine.
SENTINEL_GATEWAY_URL=http://127.0.0.1:4000/v1
OCR_URL=http://127.0.0.1:8006

# Test-only unsafe pipeline switch. It defaults to false; when true, memoryd
# uses stubs and rejects every frame ingest with 503 pipeline_not_ready.
MEMORYD_ALLOW_STUB_PIPELINE=false

# ---- data layer (Mac is the data-sovereignty side) ----
TIMELINE_DB_URL=postgresql://dejaview:dejaview@127.0.0.1:5433/dejaview
HONCHO_DB_URI=postgresql+psycopg://dejaview:dejaview@127.0.0.1:5433/honcho
REDIS_URL=redis://127.0.0.1:6380/0

# Automatic privacy-minimized timeline projection. Only activity, topics, app,
# time, schema provenance, and event_id leave memoryd; OCR/title/URL/pixels do not.
HONCHO_URL=http://127.0.0.1:8100
HONCHO_WORKSPACE=dejaview
HONCHO_PEER=owner
HONCHO_TIMEZONE=Asia/Shanghai
HONCHO_POLL_SECONDS=5
HONCHO_LEASE_SECONDS=30
HONCHO_RETRY_SECONDS=5
HONCHO_MAX_RETRY_SECONDS=300
HONCHO_MAX_ATTEMPTS=5
HONCHO_BATCH_SIZE=20

# All user artifacts (screenshots, audio, docs) live under one portable root.
DATA_ROOT=~/dejaview-data

# ---- dev-mode inference (Apple M5 16GB: start instances on demand, never all at once) ----
DEV_MODELS_DIR=~/Projects/Aidenwu0209/models/dejaview
# Dev mapping note: `brain` is served by the same E4B instance as `perceive`
# until the S2 server window (see docs/EXECUTION_HANDBOOK.md).
